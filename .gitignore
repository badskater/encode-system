data/
*.db
*.sqlite

# Editor/OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test/coverage artifacts
coverage/
*.log
# Core dumps (debug artifacts — they contain process memory incl. credentials; never commit)
core
core.*
*.core
