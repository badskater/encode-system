# encode-system controller configuration. Copy to .env and fill in.
# NEVER commit .env (gitignored).

# Management-plane admin ACCOUNT (normal login — no static bearer token).
# The account is created on first startup; ENCODE_ADMIN_PASSWORD is only used
# on that first boot (existing accounts keep their bcrypt hash). Leave the
# password empty to have one generated and logged once at startup.
# After first login, rotate it via UI (Change password) and delete this line
# — the account hash in the database is then the only credential.
ENCODE_ADMIN_USER=admin
ENCODE_ADMIN_PASSWORD=

# NFS server exporting the shares — only needed by the legacy NFS compose
# (docker/docker-compose.yml). The runtime compose uses plain volumes; point
# the controller at NFS/SMB/S3 storage from the UI (Settings → Storage shares).
#NFS_SERVER=unraid01

# Host port for the controller UI/API.
ENCODE_PORT=8080
# Bind address for the published port (security audit 2026-10). Default
# 0.0.0.0 = every interface (LAN nodes must reach the API). If the controller
# sits behind a reverse proxy on the same host, set 127.0.0.1 so the API is
# only reachable through the proxy.
#ENCODE_BIND_ADDR=127.0.0.1

# Controller image version for docker-compose.runtime.yml (install.sh sets
# this automatically; leave "latest" to track the newest release).
ENCODE_VERSION=latest

# Scanner interval in seconds.
ENCODE_SCAN_INTERVAL=30

# Reboot nodes after this many completed tasks per boot.
ENCODE_TASKS_BEFORE_REBOOT=10

# Release naming.
ENCODE_GROUP=OldFartsSubs
ENCODE_TAG=1080p
ENCODE_DEFAULT_FLOW=default-1080

# Discord job alerts (optional). Create an Incoming Webhook in your server's
# channel settings and paste the URL here; leave empty to disable.
ENCODE_DISCORD_WEBHOOK=

# --- Postgres backend (optional) -------------------------------------------
# The default backend is SQLite (state lives in the encode-state volume, file
# /data/encode.db). To run the controller against Postgres instead, set
# ENCODE_DATABASE_URL to a postgres:// DSN. The controller opens the PG
# backend on boot: store.Open → migratePG creates the schema fresh on a new
# database, no-op on an existing one. The password in the DSN is NEVER logged
# (controller logs only scheme+host+db). Empty (the default) keeps SQLite.
#ENCODE_DATABASE_URL=postgres://encode:encode@postgres:5432/encode?sslmode=disable
#
# When ENCODE_DATABASE_URL is set, bring up the postgres profile + controller
# together so PG is healthy before the controller connects:
#   docker compose --profile postgres up -d
# install.sh --postgres automates this (brings up PG, waits healthy, migrates
# an existing SQLite DB into PG via the bundled pgimport binary, wires the
# DSN into .env).
#
# Postgres service vars (only used when the postgres profile is active). The
# defaults below are for a quick local trial — CHANGE the password before any
# real deploy. POSTGRES_USER/DB become the credentials the controller's DSN
# must match; ENCODE_DATABASE_URL is built from them.
ENCODE_PG_USER=encode
ENCODE_PG_PASSWORD=changeme-encode-pg
ENCODE_PG_DB=encode
# Container name for the postgres service (default encode-postgres). Override
# for isolated test deploys.
#ENCODE_PG_CONTAINER_NAME=encode-postgres
#
# Shares encryption key file location (Postgres only). SQLite keeps the key
# beside the DB automatically (<dataDir>/encode.db.shares-key). On Postgres
# the key file path is derived from the DSN's db name under the OS temp dir
# by default — set this to a path on the encode-state volume so the key
# SURVIVES container recreation (losing it means share passwords can't be
# decrypted). Back this file up out of band (it is never inside the DB).
#ENCODE_SHARES_KEY_FILE=/data/encode.db.shares-key
