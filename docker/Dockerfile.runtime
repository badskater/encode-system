# Runtime-only image for hosts that receive a pre-built bundle (controller
# binary + built frontend). Used for offline/fast deploys where building Go
# and Node inside the image is undesirable — e.g. deploying from a machine
# with no Docker, straight over SFTP.
#
# Bundle layout next to this file:
#   controller       (CGO_ENABLED=0 GOOS=linux build of cmd/controller)
#   ui/              (frontend/dist)
FROM debian:trixie-slim
# Versions pinned to the combination validated end-to-end on the live fleet
# (ansible.windows 3.x removed win_unzip; an unpinned rebuild could pull a
# breaking release and silently break provisioning). Bump deliberately.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata wget python3 python3-pip && \
    pip3 install --break-system-packages --no-cache-dir \
        'ansible-core==2.21.3' 'pywinrm==0.5.0' && \
    ansible-galaxy collection install ansible.windows:3.7.0 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY controller /app/controller
COPY ui /app/ui
# Provision tree: provision.yml (Windows) + linux-node.yml + roles/linux-node/
# (Linux). ENCODE_PROVISION_DIR=/app/provision so PlaybookDir=/app/provision.
COPY provision /app/provision
# systemd unit: stageSystemdUnit resolves PlaybookDir/../systemd/encode-agent.service
# FIRST — /app/provision/../systemd → /app/systemd. Ships as sibling of provision/.
COPY systemd /app/systemd
# Non-root runtime (security audit 2026-10): a controller compromise must
# not start as root with the /data volume (DB, node tokens, share-cred key).
# Mirrors the build-time Dockerfile; chown /data BEFORE the volume is
# mounted over it (compose) so SQLite can create its files.
RUN addgroup --system encode && adduser --system --ingroup encode encode \
    && chmod +x /app/controller && mkdir -p /data && chown encode:encode /data
ENV ENCODE_DATA=/data \
    ENCODE_UI_DIR=/app/ui \
    ENCODE_PROVISION_DIR=/app/provision
EXPOSE 8080
USER encode
ENTRYPOINT ["/app/controller"]
