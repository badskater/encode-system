# vite 8 is used alongside @vitejs/plugin-react whose declared peer range
# ends at vite 7 (the combination works and is what the committed lockfile
# resolves to; local installs always succeeded). legacy-peer-deps keeps npm
# (v11+ on CI runners) from rejecting that resolution — npm ci honors this
# file, so CI and local installs stay consistent without touching deps.
legacy-peer-deps=true
