# group_vars/secrets.yml.example — copy to secrets.yml and fill in.
# NEVER commit secrets.yml (gitignored).
---
# WinRM credentials for Ansible to reach each node.
ansible_user: Administrator
ansible_password: CHANGE_ME

# Per-node agent tokens. Register each node via the controller UI or
# `POST /api/nodes` first, then paste the returned token here.
#
# Structure: inventory_hostname -> token
encode_node_tokens:
  enc-01: "paste-token-from-controller"
  enc-02: "paste-token-from-controller"
