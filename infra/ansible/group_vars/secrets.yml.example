# group_vars/secrets.yml.example — copy to secrets.yml and fill in.
# NEVER commit secrets.yml (gitignored).
---
# WinRM credentials for Ansible to reach each node.
ansible_user: Administrator
ansible_password: CHANGE_ME

# Per-node credentials — choose ONE form per node:
#
# Form 1 — manual token: register the node via the controller UI (or
# `POST /api/nodes`) and paste the returned token under encode_node_tokens.
#
# Structure: inventory_hostname -> token
encode_node_tokens:
  enc-01: "paste-token-from-controller"
  # enc-02: "paste-token-from-controller"
#
# Form 2 — one-shot pairing code (zero-touch): issue a code on the UI
# (Nodes page, valid 1 hour) and paste it under encode_pairing_codes. The
# agent registers itself on first start and stores its own credential.
encode_pairing_codes:
  enc-02: "paste-pairing-code-from-controller"
